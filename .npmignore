# ============================================
# AgentCore Unity Plugin — .npmignore
# 打包 .tgz 时排除的文件（不影响 Unity 安装）
# ============================================

# --- 旧版打包产物（避免嵌套打包） ---
*.tgz
*.tgz.meta

# --- npm pack 解压后的 package/ 目录（如果被误留在仓库中） ---
package/
package.meta

# --- 归档文件（旧版本遗留，用户不需要） ---
_archive/
_archive.meta

# --- 开发文档（用户不需要） ---
plans/
plans.meta
PROJECT-ANALYSIS.md
PROJECT-ANALYSIS.md.meta
AGENTS.md
AGENTS.md.meta

# --- 内部测试代码（用户不需要） ---
# Editor/Tests/ 里的都是插件内部单测 (ToolHelpers/JsonHelper/TokenCounter 等),
# asmdef defineConstraints=UNITY_INCLUDE_TESTS 仅在开发方 Test Runner 时激活.
# 终端用户装 tgz 后, 这些测试代码不参与编译但会导致 Cecil 输出
# "Failed to resolve assembly: AgentCore.Tests.Editor" 无害 warning.
# 排除后 Console 干净, tgz 体积略减, 用户零信息损失.
Editor/Tests/
Editor/Tests.meta

# --- AI 开发工具配置（用户不需要） ---
.agents/
.roo/

# --- 仓库工具脚本（打包脚本、CI helper 等，用户不需要） ---
# NOTE: 必须使用前导 '/' 明确表示仓库根目录，否则 minimatch 会同时匹配
# 任意深度的 'tools/'（包括 Editor/Tools/、Editor/VCS/Tools/ 等核心代码目录），
# 导致 npm pack 意外排除半个项目。历史事故见 CHANGELOG v1.4.6。
/tools/
/tools.meta

# --- 主项目污染（外层 Unity 项目把插件目录当子项目扫描生成）---
# NOTE: 必须使用前导 '/'，同 tools/ 规则的理由。这些目录不属于 UPM package。
# 引入用户项目后会覆盖用户自己的 Assets/Library/Logs/Packages/ProjectSettings/UserSettings，
# 属于严重污染。历史事故：alpha2 首次打包时未过滤，导致 tgz 含 ProjectSettings/*.asset。
/Assets/
/Assets.meta
/Library/
/Library.meta
/Logs/
/Logs.meta
/Packages/
/Packages.meta
/ProjectSettings/
/ProjectSettings.meta
/UserSettings/
/UserSettings.meta

# --- IDE ---
.vs/
.vscode/
.idea/
*.csproj
*.sln

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Git ---
.gitignore
.gitattributes
.git/

# --- Python 缓存 ---
__pycache__/
__pycache__.meta
*.pyc

# --- PowerShell 重定向残留 ---
$null
