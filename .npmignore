# ============================================
# AgentCore Unity Plugin — .npmignore
# 打包 .tgz 时排除的文件（不影响 Unity 安装）
# ============================================

# --- 旧版打包产物（避免嵌套打包） ---
*.tgz
*.tgz.meta

# --- npm pack 解压后的 package/ 目录（如果被误留在仓库中） ---
package/
package.meta

# --- 归档文件（旧版本遗留，用户不需要） ---
_archive/
_archive.meta

# --- 开发文档（用户不需要） ---
plans/
plans.meta
PROJECT-ANALYSIS.md
PROJECT-ANALYSIS.md.meta
AGENTS.md
AGENTS.md.meta

# --- AI 开发工具配置（用户不需要） ---
.agents/
.roo/

# --- 仓库工具脚本（打包脚本、CI helper 等，用户不需要） ---
# NOTE: 必须使用前导 '/' 明确表示仓库根目录，否则 minimatch 会同时匹配
# 任意深度的 'tools/'（包括 Editor/Tools/、Editor/VCS/Tools/ 等核心代码目录），
# 导致 npm pack 意外排除半个项目。历史事故见 CHANGELOG v1.4.6。
/tools/
/tools.meta

# --- IDE ---
.vs/
.vscode/
.idea/
*.csproj
*.sln

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Git ---
.gitignore
.git/

# --- Python 缓存 ---
__pycache__/
__pycache__.meta
*.pyc

# --- PowerShell 重定向残留 ---
$null
