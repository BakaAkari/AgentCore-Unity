# Normalize line endings for text files used in the UPM package
*.cs        text eol=lf
*.json      text eol=lf
*.asmdef    text eol=lf
*.md        text eol=lf
*.meta      text eol=lf
*.asset     text eol=lf
*.unity     text eol=lf
*.prefab    text eol=lf
*.controller text eol=lf
*.uss       text eol=lf
*.uxml      text eol=lf
*.tss       text eol=lf
*.xml       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf

# Treat common binary asset types as binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.bmp       binary
*.tga       binary
*.psd       binary
*.fbx       binary
*.obj       binary
*.blend     binary
*.wav       binary
*.mp3       binary
*.ogg       binary
*.ttf       binary
*.otf       binary
*.fontsettings binary
*.dll       binary
*.so        binary
*.dylib     binary
*.bundle    binary
