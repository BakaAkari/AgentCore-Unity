# ============================================
# RagMem - Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   nano .env
# ============================================

# ------------------------------------------
# LiteLLM Channel Configuration
# ------------------------------------------
# Your sandbox LiteLLM endpoint URL (WITHOUT trailing /v1)
# docker-compose.yml appends /v1 automatically for OpenAI SDK compatibility
# Example: http://10.0.0.100:4000 or http://litellm.internal:4000
LITELLM_BASE_URL=http://172.16.249.43:8000

# API key for LiteLLM access
LITELLM_API_KEY=sk-any

# ------------------------------------------
# LLM Model (routed through LiteLLM)
# ------------------------------------------
# Model name as registered in LiteLLM
# Common options: claude-opus-4-6, qwen-3.5-300b
LLM_MODEL=claude-opus-4-6

# ------------------------------------------
# Embedding Configuration
# ------------------------------------------
# Embedding provider: "openai" (via LiteLLM) or "ollama" (local)
#   ollama  → uses OLLAMA_BASE_URL, recommended when using local Ollama
#   openai  → uses LITELLM_BASE_URL, good when LiteLLM has embedding models registered
#             ⚠ When switching to openai, also change EMBEDDING_HOST to match LITELLM_BASE_URL
EMBEDDER_PROVIDER=ollama

# Embedding host URL (must match the provider above)
#   ollama provider → same as OLLAMA_BASE_URL
#   openai provider → same as LITELLM_BASE_URL
EMBEDDING_HOST=http://host.docker.internal:11434

# Embedding model name
# For ollama:  nomic-embed-text:v1.5 (768d), bge-m3 (1024d)
# For openai:  text-embedding-3-small (1536d), text-embedding-3-large (3072d)
EMBEDDING_MODEL=nomic-embed-text:v1.5

# Embedding dimension (MUST match the model above)
# nomic-embed-text:v1.5: 768   ← recommended default (fast, multilingual, HNSW compatible)
# bge-m3:                1024  ← alternative (larger, multilingual)
# text-embedding-3-small: 1536 ← OpenAI via LiteLLM
# NOTE: pgvector HNSW index only supports dimensions ≤ 2000.
#       Models with dim > 2000 will fall back to sequential scan (slower).
EMBEDDING_DIM=768

# ------------------------------------------
# Ollama Configuration (for embedding and/or local LLM)
# ------------------------------------------
# Ollama must listen on 0.0.0.0 for Docker containers to reach it.
# Windows: set OLLAMA_HOST=0.0.0.0 in system environment variables, then restart Ollama
# The URL below should point to the Windows host from WSL2/Docker's perspective.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ------------------------------------------
# PostgreSQL / pgvector (mem0 backend)
# ------------------------------------------
POSTGRES_USER=mem0
POSTGRES_PASSWORD=mem0pass
POSTGRES_DB=mem0
POSTGRES_PORT=18930

# ------------------------------------------
# Service Ports (accessible from Windows host via localhost)
# Uses high-numbered "cold" ports (189xx) to avoid conflicts with common services.
# ------------------------------------------
# mem0 API (maps container 8000 → host port)
MEM0_PORT=18910
# LightRAG API (maps container 9621 → host port)
LIGHTRAG_PORT=18920
# pgvector PostgreSQL (maps container 5432 → host port, internal only)
# POSTGRES_PORT=18930

# ------------------------------------------
# Neo4j (OPTIONAL - for graph memory)
# Uncomment if enabling Neo4j in docker-compose.yml
# ------------------------------------------
# NEO4J_PASSWORD=neo4jpass
