/* ============================================================
 * ChatWindow.uss — AgentCore 主窗口样式
 * 深色主题，与 Unity Editor 风格一致
 * 三列布局：Hub Rail + Context Sidebar + Main Content
 * ============================================================ */

/* --- 统一色板参考（与 C# AgentCoreColors 单一真源镜像同步）---
 * 约定：语义色改动必须同时改这里的注释、下方所有用到该色的规则、以及
 * Editor/UI/AgentCoreColors.cs，三者取值一致。
 * 注：Unity USS 的 var()/:root 自定义变量在本项目未启用（避免未验证的运行时依赖），
 * 故此处仅作取值文档，实际规则中直接写十六进制字面值。
 * 标准值（取自历史 USS 高频值）：
 *   accent 主题蓝   #4a86c8   — 强调边框 / 进行中
 *   success 成功绿  #5cb85c   — 成功 / 完成
 *   danger 危险红   #d9534f   — 失败 / 错误
 *   warning 警告黄  #f0ad4e
 *   text-primary   #d4d4d4    text-secondary  #888888
 *   card-bg        #2d2d2d    detail-bg       #272727
 * 另：用户气泡填充蓝 #3a5f8a、按钮填充蓝 #3a6fa8 为有意的较深填充色，不并入 accent。
 * error 气泡亮红文字 #ff7777、边框 #e05555 为有意的明暗层次，不并入 danger。
 */

/* --- 根容器 --- */
#root-container {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    background-color: #2b2b2b;
    height: 100%;
    -unity-font-style: bold;
}

/* --- 顶部工具栏 --- */
#toolbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    flex-grow: 0;
    padding: 4px 8px;
    background-color: #3c3c3c;
    border-bottom-width: 1px;
    border-bottom-color: #222222;
    min-height: 30px;
}

#title-label {
    font-size: 13px;
    -unity-font-style: bold;
    color: #d4d4d4;
    margin-right: 8px;
}

#toolbar-spacer {
    flex-grow: 1;
}

#status-label {
    font-size: 11px;
    color: #888888;
    margin-right: 8px;
}

.agentcore-status-chip {
    font-size: 11px;
    color: #b8c8d8;
    margin-right: 8px;
    padding: 2px 7px;
    border-radius: 8px;
    border-width: 1px;
    border-color: #3f5060;
    background-color: #2f3a44;
    flex-shrink: 0;
}

.agentcore-status-chip--pending {
    color: #d0b878;
    border-color: #5a5034;
    background-color: #3a3424;
}

.agentcore-status-chip--running {
    color: #8fbce8;
    border-color: #3f5f80;
    background-color: #28384a;
}

.agentcore-status-chip--failed {
    color: #e07070;
    border-color: #6a3a3a;
    background-color: #3a2525;
}

.agentcore-status-chip--disabled {
    color: #999999;
    border-color: #4a4a4a;
    background-color: #303030;
}

/* ============================================================
 * 三列主体布局：Hub Rail + Context Sidebar + Main Content
 * ============================================================ */

#main-body {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    overflow: hidden;
}

/* --- Hub Rail（左一列，固定宽度） --- */
.hub-rail {
    width: 52px;
    min-width: 52px;
    max-width: 52px;
    flex-shrink: 0;
    flex-direction: column;
    background-color: #1e1e1e;
    border-right-width: 1px;
    border-right-color: #151515;
}

.hub-rail__nav {
    flex-direction: column;
    padding: 4px 0;
    flex-shrink: 0;
}

.hub-rail__spacer {
    flex-grow: 1;
}

.hub-rail__button {
    width: 44px;
    height: 36px;
    margin: 2px 4px;
    padding: 0;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-radius: 6px;
    border-width: 0;
    background-color: transparent;
    color: #888888;
}

.hub-rail__button:hover {
    background-color: #333333;
    color: #cccccc;
}

.hub-rail__button:active {
    background-color: #2a2a2a;
}

.hub-rail__button--active {
    background-color: #3a4a5a;
    color: #e0e0e0;
    border-left-width: 2px;
    border-left-color: #4a86c8;
}

.hub-rail__button--active:hover {
    background-color: #3f5060;
    color: #ffffff;
}

/* 告警高亮：模块有需要关注的状态时（如 VCS 远端有更新）导航按钮变黄。 */
.hub-rail__button--alert {
    color: #f2ad1f;
    border-left-width: 2px;
    border-left-color: #f2ad1f;
}

.hub-rail__button--alert:hover {
    background-color: #3a3320;
    color: #ffc233;
}

.hub-rail__settings-button {
    margin-bottom: 6px;
    color: #777777;
}

.hub-rail__settings-button:hover {
    background-color: #333333;
    color: #aaaaaa;
}

/* --- Context Sidebar（左二列，可折叠） --- */
#context-sidebar {
    width: 200px;
    min-width: 200px;
    max-width: 200px;
    flex-shrink: 0;
    flex-direction: column;
    background-color: #252525;
    border-right-width: 1px;
    border-right-color: #1a1a1a;
    display: none;
}

#context-sidebar.sidebar-visible {
    display: flex;
}

/* 会话侧边栏内容（Chat 模块的 Context Sidebar 内容） */
#session-sidebar-content {
    flex-grow: 1;
    flex-direction: column;
}

/* 侧边栏头部 */
#sidebar-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 6px 8px;
    background-color: #2a2a2a;
    border-bottom-width: 1px;
    border-bottom-color: #1a1a1a;
    min-height: 32px;
    flex-shrink: 0;
}

#sidebar-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: #aaaaaa;
}

#new-session-button {
    height: 22px;
    font-size: 11px;
    padding: 0 8px;
    margin: 0;
    border-radius: 4px;
    background-color: #4a86c8;
    border-width: 0;
    color: #ffffff;
    -unity-font-style: bold;
}

#new-session-button:hover {
    background-color: #5a96d8;
}

#new-session-button:active {
    background-color: #3a76b8;
}

/* 会话列表滚动区域 */
#session-list-scroll {
    flex-grow: 1;
    flex-shrink: 1;
}

#session-list-container {
    flex-direction: column;
    padding: 2px 0;
}

/* 会话列表项 */
.session-item {
    flex-direction: column;
    padding: 8px 10px;
    margin: 1px 4px;
    border-radius: 4px;
    background-color: transparent;
    border-left-width: 3px;
    border-left-color: transparent;
}

.session-item:hover {
    background-color: #333333;
}

.session-item.session-active {
    background-color: #2d3a4a;
    border-left-color: #4a86c8;
}

.session-item-title {
    font-size: 13px;
    color: #d4d4d4;
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-bottom: 2px;
}

.session-item.session-active .session-item-title {
    color: #e8e8e8;
}

.session-item-time {
    font-size: 11px;
    color: #777777;
}

.session-item.session-active .session-item-time {
    color: #8899aa;
}

/* 会话项内联重命名输入框 */
.session-rename-field {
    font-size: 13px;
    color: #d4d4d4;
    background-color: #1e1e1e;
    border-width: 1px;
    border-color: #4a86c8;
    border-radius: 3px;
    padding: 2px 4px;
    margin: 0;
    height: 20px;
}

.session-rename-field > #unity-text-input {
    background-color: #1e1e1e;
    border-width: 0;
    padding: 1px 4px;
    color: #d4d4d4;
    font-size: 13px;
}

/* --- 主内容区域（右列，flex-grow） --- */
#main-content {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    overflow: hidden;
}

/* --- Chat 面板 --- */
#chat-panel {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    overflow: hidden;
}

/* --- 聊天内容区域 --- */
#chat-area {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    overflow: hidden;
}

/* --- 消息滚动区域 --- */
#message-scroll-wrapper {
    flex-grow: 1;
    flex-shrink: 1;
    position: relative;
}

#message-scroll-view {
    flex-grow: 1;
    flex-shrink: 1;
    background-color: #2b2b2b;
}

#message-scroll-view > #unity-content-container {
    padding: 8px 0;
    flex-grow: 0;
    flex-shrink: 0;
}

#message-container {
    flex-direction: column;
    padding: 4px 0;
}

/* --- "跳到最新"浮动按钮（用户上翻时显示） --- */
#scroll-to-bottom-button {
    position: absolute;
    right: 14px;
    bottom: 12px;
    height: 26px;
    padding: 0 12px;
    background-color: #4a86c8;
    color: #ffffff;
    border-width: 0;
    border-radius: 13px;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

#scroll-to-bottom-button:hover {
    background-color: #5a96d8;
}

/* --- 底部输入区域 --- */
#input-area {
    flex-direction: row;
    align-items: flex-end;
    flex-shrink: 0;
    flex-grow: 0;
    padding: 8px;
    background-color: #383838;
    border-top-width: 1px;
    border-top-color: #555555;
    min-height: 88px;
    max-height: 260px;
}

/* 输入框滚动包装：内容多时可上下滚动查看 */
#input-scroll-view {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 28px;
    max-height: 220px;
    margin-right: 8px;
    background-color: #2b2b2b;
    border-radius: 6px;
    border-width: 1px;
    border-color: #555555;
}

#input-scroll-view > #unity-content-container {
    flex-grow: 1;
    flex-shrink: 0;
    padding: 0;
}

#input-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 28px;
    font-size: 13px;
    color: #d4d4d4;
    background-color: transparent;
    border-width: 0;
    padding: 4px 8px;
    white-space: normal;
    overflow: visible;
}

#input-field:focus {
    border-color: #4a86c8;
}

/* Unity TextField 内部文本元素 */
#input-field > .unity-text-element {
    white-space: normal;
    color: #d4d4d4;
    padding: 2px 0;
}

/* Unity TextField multiline 内部 TextInput 容器 */
#input-field > #unity-text-input {
    background-color: transparent;
    border-width: 0;
    padding: 4px 8px;
    min-height: 20px;
    white-space: normal;
    overflow: visible;
}


#input-buttons {
    flex-direction: row;
    flex-shrink: 0;
    align-items: flex-end;
    margin-bottom: 0;
}

/* 思考强度快捷切换下拉（v1.14.10）：与 #send-button / #cancel-button 同一套设计语言——
   28px 高、6px 圆角、无边框，颜色沿用输入框深色底（#2b2b2b）+ 蓝色 focus 强调（#4a86c8），
   而不是 Unity 默认的浅灰色下拉框外观，保持与整个 chat 面板深色主题一致。 */
.agentcore-reasoning-level-selector {
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 0;
    margin: 0 4px 0 0;
}

.agentcore-reasoning-level-selector__popup {
    width: 64px;
    min-width: 64px;
    max-width: 64px;
    height: 28px;
    flex-grow: 0;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    background-color: #2b2b2b;
    border-radius: 6px;
    border-width: 1px;
    border-color: #555555;
    justify-content: center;
}

.agentcore-reasoning-level-selector__popup:hover {
    background-color: #333333;
    border-color: #666666;
}

.agentcore-reasoning-level-selector__popup:focus {
    border-color: #4a86c8;
}

/* PopupField 真实的内部结构是 unity-base-popup-field__text（文字）+ __arrow（箭头），
   没有 __input/__label 这类子类名（此前 C# 里 Q<Label>(className: "unity-base-field__label")
   隐藏标签的写法命中的是不存在的类名，一直没生效——这里改用验证过真实存在的 __text）。 */
.agentcore-reasoning-level-selector__popup .unity-base-popup-field__text {
    color: #d4d4d4;
    font-size: 12px;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.agentcore-reasoning-level-selector__popup .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: #999999;
}

#send-button {
    width: 60px;
    height: 28px;
    font-size: 13px;
    -unity-font-style: bold;
    background-color: #4a86c8;
    border-radius: 6px;
    border-width: 0;
    color: #ffffff;
    margin: 0;
    padding: 0;
}

#send-button:hover {
    background-color: #5a96d8;
}

#send-button:active {
    background-color: #3a76b8;
}

#send-button:disabled {
    background-color: #3a5570;
    color: #888888;
}

#cancel-button {
    width: 60px;
    height: 28px;
    font-size: 13px;
    -unity-font-style: bold;
    background-color: #c84a4a;
    border-radius: 6px;
    border-width: 0;
    color: #ffffff;
    margin: 0 0 0 4px;
    padding: 0;
    display: none;
}

#cancel-button:hover {
    background-color: #d85a5a;
}

#cancel-button:active {
    background-color: #b83a3a;
}

/* --- 内嵌工具确认面板 --- */
.tool-confirmation-panel {
    flex-shrink: 0;
    flex-grow: 0;
    margin: 6px 8px 0 8px;
    padding: 10px 12px;
    background-color: #332b1f;
    border-width: 1px;
    border-color: #7a5a2b;
    border-radius: 7px;
}

.tool-confirmation-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.tool-confirmation-title {
    flex-grow: 1;
    font-size: 13px;
    -unity-font-style: bold;
    color: #f0d090;
}

.tool-confirmation-risk {
    font-size: 11px;
    color: #c8a86c;
    margin-left: 8px;
}

.tool-confirmation-description {
    font-size: 12px;
    color: #e0d0b8;
    white-space: normal;
    margin-bottom: 7px;
}

.tool-confirmation-block {
    margin-top: 4px;
    margin-bottom: 2px;
}

.tool-confirmation-section-title {
    font-size: 10px;
    -unity-font-style: bold;
    color: #b89058;
    margin-bottom: 2px;
    letter-spacing: 0.4px;
}

.tool-confirmation-item {
    font-size: 11px;
    color: #d0c0a8;
    white-space: normal;
    margin-left: 4px;
    margin-top: 1px;
}

.tool-confirmation-footer {
    flex-direction: column;
    align-items: stretch;
    margin-top: 8px;
}

.tool-confirmation-meta {
    flex-grow: 0;
    flex-shrink: 0;
    margin-bottom: 6px;
    font-size: 11px;
    color: #a89070;
    white-space: normal;
}

.tool-confirmation-buttons {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    justify-content: flex-end;
}

/* ask_user 选项面板：候选选项竖排、全宽、可换行 */
.ask-user-options {
    flex-direction: column;
    flex-shrink: 0;
    margin-top: 6px;
}

.ask-user-option-button {
    height: auto;
    min-height: 26px;
    margin-left: 0;
    margin-top: 5px;
    padding: 5px 10px;
    background-color: #3a4a63;
    white-space: normal;
    -unity-text-align: middle-left;
}

.ask-user-option-button:hover {
    background-color: #47597a;
}

.ask-user-freetext-button {
    height: auto;
    min-height: 26px;
    margin-left: 0;
    margin-top: 8px;
    padding: 5px 10px;
    background-color: #4a4a4a;
    -unity-font-style: normal;
    white-space: normal;
    -unity-text-align: middle-left;
}

.ask-user-freetext-button:hover {
    background-color: #565656;
}

/* 确保按钮内部的文本元素也允许换行 —— Unity Button 的内部 unity-text-element 默认 nowrap，
   长按钮文字（如"Trust Low/Med for Session"、长选项）在窄窗口下会被截断。 */
.ask-user-option-button > .unity-text-element,
.ask-user-freetext-button > .unity-text-element,
.tool-confirmation-button > .unity-text-element {
    white-space: normal;
}

/* ask_user 专用 meta 提示：column 流式布局，不复用带 flex-grow:1 的 .tool-confirmation-meta
   （那个是给 row 布局的确认面板设计的，放进 column 会撑开并与选项按钮重叠）。 */
.ask-user-meta {
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: 10px;
    font-size: 11px;
    color: #a89070;
    white-space: normal;
}

.tool-confirmation-button {
    height: auto;
    min-height: 24px;
    min-width: 60px;
    flex-shrink: 1;
    margin-left: 6px;
    margin-top: 6px;
    padding: 4px 10px;
    border-radius: 5px;
    border-width: 0;
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
    color: #ffffff;
}

.tool-confirmation-button--reject {
    background-color: #7a3a3a;
}

.tool-confirmation-button--reject:hover {
    background-color: #8a4848;
}

.tool-confirmation-button--trust {
    background-color: #4c668f;
}

.tool-confirmation-button--trust:hover {
    background-color: #5a78a6;
}

.tool-confirmation-button--approve {
    background-color: #4f7f45;
}

.tool-confirmation-button--approve:hover {
    background-color: #5f9054;
}

/* v1.6.5: YOLO 按钮 (会话内全部风险直通),暖橙色系,强调警示与"激进"属性 */
.tool-confirmation-button--yolo {
    background-color: #b8621b;
    color: #ffffff;
}

.tool-confirmation-button--yolo:hover {
    background-color: #d0771f;
}

/* ============================================================
 * Knowledge 面板样式（Phase Hub-2）
 * ============================================================ */

#knowledge-panel {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    display: none;
    overflow: scroll;
}

/* KnowledgeBasePanel 根容器 */
.knowledge-panel-content {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    padding: 16px;
    overflow: scroll;
    min-height: 0;
}

/* 面板标题 */
.kb-panel__title {
    font-size: 16px;
    -unity-font-style: bold;
    color: #d4d4d4;
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #3a3a3a;
}

/* 区块容器 */
.kb-panel__section {
    flex-direction: column;
    flex-shrink: 0;
    margin-bottom: 16px;
    padding: 12px;
    background-color: #333333;
    border-radius: 6px;
    border-width: 1px;
    border-color: #3f3f3f;
}

/* 区块标题 */
.kb-panel__section-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: #888888;
    margin-bottom: 8px;
    letter-spacing: 0.5px;
}

/* 状态行 */
.kb-panel__status-row {
    font-size: 12px;
    color: #cccccc;
    margin-bottom: 4px;
}

.kb-panel__status-row--muted {
    color: #888888;
    font-size: 11px;
}

/* 状态颜色修饰 */
.kb-panel__status--enabled {
    color: #5cb85c;
}

.kb-panel__status--disabled {
    color: #d9534f;
}

.kb-panel__status--connected {
    color: #5cb85c;
}

.kb-panel__status--failed {
    color: #d9534f;
}

.kb-panel__status--testing {
    color: #f0ad4e;
}

/* 按钮行 */
.kb-panel__button-row {
    flex-direction: row;
    margin-top: 8px;
    flex-wrap: wrap;
}

/* 通用按钮 */
.kb-panel__button {
    height: 26px;
    font-size: 12px;
    padding: 0 12px;
    margin-right: 6px;
    margin-bottom: 4px;
    border-radius: 4px;
    border-width: 1px;
    border-color: #555555;
    background-color: #444444;
    color: #cccccc;
}

.kb-panel__button:hover {
    background-color: #505050;
    color: #ffffff;
}

.kb-panel__button:active {
    background-color: #3a3a3a;
}

.kb-panel__button:disabled {
    background-color: #333333;
    color: #666666;
    border-color: #444444;
}

/* 主要按钮（蓝色） */
.kb-panel__button--primary {
    background-color: #2d5a8e;
    border-color: #3a6fa8;
    color: #e0e0e0;
    -unity-font-style: bold;
    height: 30px;
    font-size: 13px;
    width: 100%;
    margin-right: 0;
}

.kb-panel__button--primary:hover {
    background-color: #3a6fa8;
    color: #ffffff;
}

.kb-panel__button--primary:active {
    background-color: #234a7a;
}

.kb-panel__button--primary:disabled {
    background-color: #1e3a5a;
    color: #666666;
    border-color: #2a4a6a;
}

/* 次要按钮 */
.kb-panel__button--secondary {
    background-color: transparent;
    border-color: #555555;
    color: #888888;
}

.kb-panel__button--secondary:hover {
    background-color: #3a3a3a;
    color: #cccccc;
}

/* 强调按钮（绿色，Ask Agent） */
.kb-panel__button--accent {
    background-color: #2d6e3e;
    border-color: #3a8a50;
    color: #e0e0e0;
    -unity-font-style: bold;
    height: 30px;
    font-size: 13px;
    width: 100%;
    margin-right: 0;
    margin-top: 8px;
}

.kb-panel__button--accent:hover {
    background-color: #3a8a50;
    color: #ffffff;
}

.kb-panel__button--accent:active {
    background-color: #235530;
}

/* 提示文字 */
.kb-panel__hint {
    font-size: 11px;
    color: #666666;
    margin-top: 6px;
    white-space: normal;
}

/* 结果标签 */
.kb-panel__result-label {
    font-size: 12px;
    color: #cccccc;
    white-space: normal;
    margin-bottom: 4px;
}

.kb-panel__result--success {
    color: #5cb85c;
}

.kb-panel__result--failed {
    color: #d9534f;
}

/* 进度遮罩 */
.kb-panel__progress-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    align-items: center;
    justify-content: center;
    border-radius: 4px;
}

.kb-panel__progress-label {
    font-size: 13px;
    color: #d4d4d4;
    -unity-font-style: bold;
}

/* ============================================================
 * Memory 面板样式
 * ============================================================ */

#memory-panel {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    display: none;
    overflow: scroll;
}

.memory-panel-content {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    padding: 16px;
    overflow: scroll;
    min-height: 0;
}

.memory-panel__title {
    font-size: 16px;
    -unity-font-style: bold;
    color: #d4d4d4;
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #3a3a3a;
}

.memory-panel__section {
    flex-direction: column;
    flex-shrink: 0;
    margin-bottom: 16px;
    padding: 12px;
    background-color: #333333;
    border-radius: 6px;
    border-width: 1px;
    border-color: #3f3f3f;
}

.memory-panel__section-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: #888888;
    margin-bottom: 8px;
    letter-spacing: 0.5px;
}

.memory-panel__status-row {
    font-size: 12px;
    color: #cccccc;
    margin-bottom: 4px;
}

.memory-panel__status-row--muted {
    color: #888888;
    font-size: 11px;
}

.memory-panel__status--ok {
    color: #5cb85c;
}

.memory-panel__status--warn {
    color: #f0ad4e;
}

.memory-panel__status--error {
    color: #d9534f;
}

.memory-panel__button-row {
    flex-direction: row;
    margin-top: 8px;
    flex-wrap: wrap;
}

.memory-panel__button {
    height: 26px;
    font-size: 12px;
    padding: 0 12px;
    margin-right: 6px;
    margin-bottom: 4px;
    border-radius: 4px;
    border-width: 1px;
    border-color: #555555;
    background-color: #444444;
    color: #cccccc;
}

.memory-panel__button:hover {
    background-color: #505050;
    color: #ffffff;
}

.memory-panel__button:active {
    background-color: #3a3a3a;
}

.memory-panel__button:disabled {
    background-color: #333333;
    color: #666666;
    border-color: #444444;
}

.memory-panel__button--primary {
    background-color: #2d5a8e;
    border-color: #3a6fa8;
    color: #e0e0e0;
    -unity-font-style: bold;
    height: 30px;
    font-size: 13px;
    width: 100%;
    margin-right: 0;
    margin-top: 8px;
}

.memory-panel__button--primary:hover {
    background-color: #3a6fa8;
    color: #ffffff;
}

.memory-panel__button--secondary {
    background-color: transparent;
    border-color: #555555;
    color: #888888;
}

.memory-panel__button--secondary:hover {
    background-color: #3a3a3a;
    color: #cccccc;
}

.memory-panel__button--small {
    height: 20px;
    font-size: 11px;
    padding: 0 8px;
    margin-right: 0;
    margin-bottom: 0;
}

.memory-panel__button--danger {
    background-color: #5a2020;
    border-color: #7a3030;
    color: #e08080;
}

.memory-panel__button--danger:hover {
    background-color: #7a2a2a;
    color: #ffaaaa;
    border-color: #aa4040;
}

.memory-panel__hint {
    font-size: 11px;
    color: #666666;
    margin-top: 6px;
    white-space: normal;
}

.memory-panel__result-label {
    font-size: 12px;
    color: #cccccc;
    white-space: normal;
    margin-top: 6px;
    margin-bottom: 4px;
}

.memory-panel__result--success {
    color: #5cb85c;
}

.memory-panel__result--failed {
    color: #d9534f;
}

.memory-panel__text-field {
    min-height: 74px;
    max-height: 120px;
    background-color: #2b2b2b;
    border-radius: 4px;
    border-width: 1px;
    border-color: #555555;
    color: #d4d4d4;
    white-space: normal;
}

.memory-panel__text-field > #unity-text-input {
    background-color: #2b2b2b;
    border-width: 0;
    color: #d4d4d4;
    white-space: normal;
}

.memory-panel__list-title-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.memory-panel__memories-scroll {
    background-color: #2a2a2a;
    border-radius: 4px;
    border-width: 1px;
    border-color: #3a3a3a;
    margin-top: 4px;
    margin-bottom: 4px;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 120px;
}

.memory-panel__memory-item {
    flex-direction: column;
    padding: 8px 10px;
    border-bottom-width: 1px;
    border-bottom-color: #3a3a3a;
    background-color: transparent;
}

.memory-panel__memory-item:hover {
    background-color: #333333;
}

.memory-panel__memory-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.memory-panel__memory-title {
    font-size: 12px;
    color: #d4d4d4;
    -unity-font-style: bold;
    flex-grow: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.memory-panel__memory-content {
    font-size: 12px;
    color: #cccccc;
    white-space: normal;
    margin-bottom: 4px;
}

.memory-panel__memory-meta {
    font-size: 11px;
    color: #777777;
    white-space: normal;
}

/* ============================================================
 * Domain Reload 恢复通知卡片样式
 * 琥珀色/橙色主题，深色背景，与现有 UI 风格协调
 * ============================================================ */

/* --- 通知卡片容器 --- */
.domain-reload-notification {
    flex-direction: column;
    margin: 8px 12px;
    padding: 10px 14px;
    border-radius: 6px;
    background-color: #2a2520;
    border-width: 1px;
    border-color: #8b6914;
    border-left-width: 3px;
    border-left-color: #d4a017;
}

/* --- 标题行（图标 + 文字） --- */
.domain-reload-notification__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.domain-reload-notification__header-icon {
    font-size: 14px;
    color: #d4a017;
    margin-right: 6px;
    flex-shrink: 0;
}

.domain-reload-notification__header-text {
    font-size: 12px;
    -unity-font-style: bold;
    color: #d4a017;
    flex-grow: 1;
}

/* --- 详情行 --- */
.domain-reload-notification__detail {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
    margin-bottom: 1px;
    margin-left: 20px;
}

.domain-reload-notification__detail-label {
    font-size: 11px;
    color: #999080;
    min-width: 72px;
    flex-shrink: 0;
}

.domain-reload-notification__detail-value {
    font-size: 11px;
    color: #c8b890;
    flex-grow: 1;
}

/* --- 状态行 --- */
.domain-reload-notification__status {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: #3a3530;
}

.domain-reload-notification__status-icon {
    font-size: 12px;
    margin-right: 6px;
    flex-shrink: 0;
    color: #d4a017;
}

.domain-reload-notification__status-text {
    font-size: 11px;
    color: #b8a878;
}

/* --- 成功状态修饰 --- */
.domain-reload-notification--success .domain-reload-notification__status-icon {
    color: #5cb85c;
}

.domain-reload-notification--success .domain-reload-notification__status-text {
    color: #7dce7d;
}

.domain-reload-notification--success {
    border-left-color: #5cb85c;
    border-color: #3a6b3a;
}

/* --- 失败状态修饰 --- */
.domain-reload-notification--error .domain-reload-notification__status-icon {
    color: #d9534f;
}

.domain-reload-notification--error .domain-reload-notification__status-text {
    color: #e8706c;
}

.domain-reload-notification--error {
    border-left-color: #d9534f;
    border-color: #6b3a3a;
}

/* --- 编译成功标记 --- */
.domain-reload-notification__compile-success {
    color: #5cb85c;
}

/* --- 编译失败标记 --- */
.domain-reload-notification__compile-error {
    color: #d9534f;
}

/* ============================================================
 * 工具调用分组容器样式
 * 将所有工具调用统一在一个可折叠的容器中
 * ============================================================ */

/* --- 分组容器根 --- */
.tool-call-group {
    flex-direction: column;
    margin: 4px 8px;
    border-radius: 4px;
    border-width: 1px;
    border-color: #383838;
    border-left-width: 3px;
    border-left-color: #4a86c8;
    overflow: hidden;
}

/* --- 分组头部（可点击） --- */
.tool-call-group__header {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    background-color: #333333;
    padding: 6px 10px;
    min-height: 28px;
}

.tool-call-group__header:hover {
    background-color: #3D3D3D;
}

/* --- 折叠箭头 --- */
.tool-call-group__arrow {
    font-size: 10px;
    color: #888888;
    margin-right: 6px;
    min-width: 14px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

/* --- 标题文本 --- */
.tool-call-group__title {
    font-size: 12px;
    color: #D4D4D4;
    -unity-font-style: bold;
    margin-right: 8px;
    flex-shrink: 1;
    white-space: normal;
}

/* --- 摘要标签 --- */
.tool-call-group__summary {
    font-size: 11px;
    color: #888888;
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

/* --- 内容区域 --- */
.tool-call-group__content {
    flex-direction: column;
    background-color: #292929;
    padding: 2px 0;
}

/* ============================================================
 * Knowledge Base 文档列表样式（Phase RAG-Doc-1）
 * ============================================================ */

/* 小尺寸按钮（刷新、删除等行内按钮） */
.kb-panel__button--small {
    height: 20px;
    font-size: 11px;
    padding: 0 8px;
    margin-right: 0;
    margin-bottom: 0;
}

/* 危险按钮（删除，红色） */
.kb-panel__button--danger {
    background-color: #5a2020;
    border-color: #7a3030;
    color: #e08080;
}

.kb-panel__button--danger:hover {
    background-color: #7a2a2a;
    color: #ffaaaa;
    border-color: #aa4040;
}

.kb-panel__button--danger:active {
    background-color: #3a1515;
}

/* 文档列表 ScrollView */
.kb-panel__docs-scroll {
    background-color: #2a2a2a;
    border-radius: 4px;
    border-width: 1px;
    border-color: #3a3a3a;
    margin-top: 4px;
    margin-bottom: 4px;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 100px;
}

/* 文档列表条目 */
.kb-panel__doc-item {
    flex-direction: column;
    padding: 8px 10px;
    border-bottom-width: 1px;
    border-bottom-color: #3a3a3a;
    background-color: transparent;
}

.kb-panel__doc-item:hover {
    background-color: #333333;
}

/* 文档条目：文件名 */
.kb-panel__doc-item__name {
    font-size: 12px;
    color: #d4d4d4;
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* 文档条目：摘要 */
.kb-panel__doc-item__summary {
    font-size: 11px;
    color: #888888;
    margin-top: 3px;
    white-space: normal;
}

/* 文档条目：错误信息 */
.kb-panel__doc-item__error {
    font-size: 11px;
    color: #d9534f;
    margin-top: 3px;
    white-space: normal;
}

/* 文档条目：元信息（块数等） */
.kb-panel__doc-item__meta {
    font-size: 10px;
    color: #666666;
    margin-top: 4px;
}

/* 文档条目：底部行 */
.kb-panel__doc-item__bottom-row {
    margin-top: 4px;
}

/* 文档条目：状态徽章 */
.kb-panel__doc-item__status-badge {
    font-size: 10px;
    -unity-font-style: bold;
    padding: 1px 6px;
    border-radius: 3px;
    border-width: 1px;
    margin-left: 6px;
    flex-shrink: 0;
}

/* 状态徽章 — 已处理（绿色） */
.kb-panel__doc-item__status-badge--processed {
    color: #5cb85c;
    border-color: #3a6b3a;
    background-color: #1a3a1a;
}

/* 状态徽章 — 处理中（黄色） */
.kb-panel__doc-item__status-badge--pending {
    color: #f0ad4e;
    border-color: #7a5a20;
    background-color: #2a2010;
}

/* 状态徽章 — 失败（红色） */
.kb-panel__doc-item__status-badge--failed {
    color: #d9534f;
    border-color: #6b3a3a;
    background-color: #2a1515;
}

/* 状态徽章 — 未知 */
.kb-panel__doc-item__status-badge--unknown {
    color: #888888;
    border-color: #555555;
    background-color: #2a2a2a;
}

/* ============================================================
 * Active Pulse — 用于运行中组件的视觉信号
 * Unity UI Toolkit 无 @keyframes，改用高对比边框色 + transition 做静态活动指示
 * 通过 AddToClassList("active-pulse") / RemoveFromClassList("active-pulse") 切换
 * ============================================================ */
.active-pulse {
    border-left-color: #4a86c8;
    border-right-color: #4a86c8;
    border-top-color: #4a86c8;
    border-bottom-color: #4a86c8;
    transition-property: border-color;
    transition-duration: 0.5s;
    transition-timing-function: ease-in-out;
}

/* --- 折叠状态下 ThinkingDrawer 的预览文本 --- */
.thinking-drawer__preview {
    max-width: 400px;
}

/* ============================================================
 * HelpBubble — 马里奥问号方块风格的帮助浮窗
 * 黄色方块 + ? 符号，hover 弹出技巧面板
 * ============================================================ */

/* --- 问号方块按钮 --- */
.help-bubble__button {
    width: 36px;
    height: 36px;
    margin: 2px 8px;
    padding: 0;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-radius: 4px;
    border-width: 2px;
    border-color: #b8860b;
    background-color: #fbc02d;
    color: #3e2723;
    transition-property: background-color, transform;
    transition-duration: 120ms;
    transition-timing-function: ease-in-out;
}

/* hover 时方块微微变亮 + 轻微弹跳感（通过 scale 模拟） */
.help-bubble__button:hover {
    background-color: #ffd54f;
    border-color: #ff8f00;
    color: #1a1a1a;
}

/* 按下时方块回压 */
.help-bubble__button:active {
    background-color: #f9a825;
}

/* 面板显示时按钮的激活态（类似马里奥方块被顶到后的状态） */
.help-bubble__button--active {
    background-color: #ff8f00;
    border-color: #e65100;
    color: #fff8e1;
}

/* --- 浮动面板容器（absolute 定位，添加到宿主窗口 rootVisualElement） --- */
.help-bubble__panel {
    position: absolute;
    background-color: #2e2e2e;
    border-width: 1px;
    border-color: #555555;
    border-radius: 6px;
    overflow: hidden;
}

/* --- 面板标题 --- */
.help-bubble__panel-title {
    flex-shrink: 0;
    font-size: 17px;
    -unity-font-style: bold;
    color: #fbc02d;
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: #444444;
}

/* --- 分区标题 --- */
.help-bubble__section-header {
    flex-shrink: 0;
    font-size: 13px;
    -unity-font-style: bold;
    color: #999999;
    margin-top: 14px;
    margin-bottom: 8px;
    letter-spacing: 1px;
}


/* --- 快捷键条目行 --- */
.help-bubble__shortcut-row {
    flex-direction: row;
    align-items: flex-start;
    flex-shrink: 0;
    margin-bottom: 10px;
    padding: 4px 0;
}

/* 快捷键按键标签 — 类似键盘按键样式 */
.help-bubble__shortcut-key {
    flex-shrink: 0;
    min-width: 104px;
    max-width: 104px;
    font-size: 12px;
    -unity-font-style: bold;
    color: #fbc02d;
    background-color: #3a3520;
    border-width: 1px;
    border-color: #5a4a1b;
    border-radius: 4px;
    padding: 4px 8px;
    margin-right: 12px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* 快捷键说明文字 */
.help-bubble__shortcut-desc {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 13px;
    color: #c8c8c8;
    white-space: normal;
    overflow: hidden;
}

/* --- 纯文本技巧条目 --- */
.help-bubble__tip-item {
    flex-shrink: 0;
    font-size: 14px;
    -unity-font-style: bold;
    color: #d8d8d8;
    margin-bottom: 8px;
    padding: 5px 8px;
    padding-left: 12px;
    border-left-width: 2px;
    border-left-color: #fbc02d;
    white-space: normal;
}

/* v1.12.0 — session organization: group headers, tag chips */

.session-group-header {
    margin-top: 4px;
    margin-bottom: 2px;
    padding-left: 4px;
    -unity-font-style: bold;
    font-size: 11px;
    color: rgb(200, 200, 200);
}

.session-group-header > .unity-foldout__toggle {
    background-color: rgba(0, 0, 0, 0);
}

.session-item-tag-chip {
    margin-right: 6px;
    padding: 1px 6px 1px 6px;
    background-color: rgb(60, 90, 130);
    color: rgb(220, 230, 245);
    font-size: 10px;
    border-radius: 3px;
    -unity-text-align: middle-center;
    align-self: center;
    flex-shrink: 0;
}
