/* ============================================================
 * ChatWindow.uss — AgentCore 主窗口样式
 * 深色主题，与 Unity Editor 风格一致
 * 三列布局：Hub Rail + Context Sidebar + Main Content
 * ============================================================ */

/* --- 根容器 --- */
#root-container {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    background-color: #2b2b2b;
    height: 100%;
    -unity-font-style: bold;
}

/* --- 顶部工具栏 --- */
#toolbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    flex-grow: 0;
    padding: 4px 8px;
    background-color: #3c3c3c;
    border-bottom-width: 1px;
    border-bottom-color: #222222;
    min-height: 30px;
}

#title-label {
    font-size: 13px;
    -unity-font-style: bold;
    color: #d4d4d4;
    margin-right: 8px;
}

#toolbar-spacer {
    flex-grow: 1;
}

#status-label {
    font-size: 11px;
    color: #888888;
    margin-right: 8px;
}

.agentcore-status-chip {
    font-size: 11px;
    color: #b8c8d8;
    margin-right: 8px;
    padding: 2px 7px;
    border-radius: 8px;
    border-width: 1px;
    border-color: #3f5060;
    background-color: #2f3a44;
    flex-shrink: 0;
}

.agentcore-status-chip--pending {
    color: #d0b878;
    border-color: #5a5034;
    background-color: #3a3424;
}

.agentcore-status-chip--running {
    color: #8fbce8;
    border-color: #3f5f80;
    background-color: #28384a;
}

.agentcore-status-chip--failed {
    color: #e07070;
    border-color: #6a3a3a;
    background-color: #3a2525;
}

.agentcore-status-chip--disabled {
    color: #999999;
    border-color: #4a4a4a;
    background-color: #303030;
}

/* ============================================================
 * 三列主体布局：Hub Rail + Context Sidebar + Main Content
 * ============================================================ */

#main-body {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    overflow: hidden;
}

/* --- Hub Rail（左一列，固定宽度） --- */
.hub-rail {
    width: 52px;
    min-width: 52px;
    max-width: 52px;
    flex-shrink: 0;
    flex-direction: column;
    background-color: #1e1e1e;
    border-right-width: 1px;
    border-right-color: #151515;
}

.hub-rail__nav {
    flex-direction: column;
    padding: 4px 0;
    flex-shrink: 0;
}

.hub-rail__spacer {
    flex-grow: 1;
}

.hub-rail__button {
    width: 44px;
    height: 36px;
    margin: 2px 4px;
    padding: 0;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-radius: 6px;
    border-width: 0;
    background-color: transparent;
    color: #888888;
}

.hub-rail__button:hover {
    background-color: #333333;
    color: #cccccc;
}

.hub-rail__button:active {
    background-color: #2a2a2a;
}

.hub-rail__button--active {
    background-color: #3a4a5a;
    color: #e0e0e0;
    border-left-width: 2px;
    border-left-color: #4a86c8;
}

.hub-rail__button--active:hover {
    background-color: #3f5060;
    color: #ffffff;
}

.hub-rail__settings-button {
    margin-bottom: 6px;
    color: #777777;
}

.hub-rail__settings-button:hover {
    background-color: #333333;
    color: #aaaaaa;
}

/* --- Context Sidebar（左二列，可折叠） --- */
#context-sidebar {
    width: 200px;
    min-width: 200px;
    max-width: 200px;
    flex-shrink: 0;
    flex-direction: column;
    background-color: #252525;
    border-right-width: 1px;
    border-right-color: #1a1a1a;
    display: none;
}

#context-sidebar.sidebar-visible {
    display: flex;
}

/* 会话侧边栏内容（Chat 模块的 Context Sidebar 内容） */
#session-sidebar-content {
    flex-grow: 1;
    flex-direction: column;
}

/* 侧边栏头部 */
#sidebar-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 6px 8px;
    background-color: #2a2a2a;
    border-bottom-width: 1px;
    border-bottom-color: #1a1a1a;
    min-height: 32px;
    flex-shrink: 0;
}

#sidebar-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: #aaaaaa;
}

#new-session-button {
    height: 22px;
    font-size: 11px;
    padding: 0 8px;
    margin: 0;
    border-radius: 4px;
    background-color: #4a86c8;
    border-width: 0;
    color: #ffffff;
    -unity-font-style: bold;
}

#new-session-button:hover {
    background-color: #5a96d8;
}

#new-session-button:active {
    background-color: #3a76b8;
}

/* 会话列表滚动区域 */
#session-list-scroll {
    flex-grow: 1;
    flex-shrink: 1;
}

#session-list-container {
    flex-direction: column;
    padding: 2px 0;
}

/* 会话列表项 */
.session-item {
    flex-direction: column;
    padding: 8px 10px;
    margin: 1px 4px;
    border-radius: 4px;
    background-color: transparent;
    border-left-width: 3px;
    border-left-color: transparent;
}

.session-item:hover {
    background-color: #333333;
}

.session-item.session-active {
    background-color: #2d3a4a;
    border-left-color: #4a86c8;
}

.session-item-title {
    font-size: 13px;
    color: #d4d4d4;
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-bottom: 2px;
}

.session-item.session-active .session-item-title {
    color: #e8e8e8;
}

.session-item-time {
    font-size: 11px;
    color: #777777;
}

.session-item.session-active .session-item-time {
    color: #8899aa;
}

/* 会话项内联重命名输入框 */
.session-rename-field {
    font-size: 13px;
    color: #d4d4d4;
    background-color: #1e1e1e;
    border-width: 1px;
    border-color: #4a86c8;
    border-radius: 3px;
    padding: 2px 4px;
    margin: 0;
    height: 20px;
}

.session-rename-field > #unity-text-input {
    background-color: #1e1e1e;
    border-width: 0;
    padding: 1px 4px;
    color: #d4d4d4;
    font-size: 13px;
}

/* --- 主内容区域（右列，flex-grow） --- */
#main-content {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    overflow: hidden;
}

/* --- Chat 面板 --- */
#chat-panel {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    overflow: hidden;
}

/* --- 聊天内容区域 --- */
#chat-area {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    overflow: hidden;
}

/* --- 消息滚动区域 --- */
#message-scroll-view {
    flex-grow: 1;
    flex-shrink: 1;
    background-color: #2b2b2b;
}

#message-scroll-view > #unity-content-container {
    padding: 8px 0;
}

#message-container {
    flex-direction: column;
    padding: 4px 0;
}

/* --- 底部输入区域 --- */
#input-area {
    flex-direction: row;
    align-items: flex-end;
    flex-shrink: 0;
    flex-grow: 0;
    padding: 8px;
    background-color: #383838;
    border-top-width: 1px;
    border-top-color: #555555;
    min-height: 44px;
    max-height: 140px;
}

#input-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 28px;
    max-height: 100px;
    margin-right: 8px;
    font-size: 13px;
    color: #d4d4d4;
    background-color: #2b2b2b;
    border-radius: 6px;
    border-width: 1px;
    border-color: #555555;
    padding: 4px 8px;
    white-space: normal;
    overflow: hidden;
}

#input-field:focus {
    border-color: #4a86c8;
}

/* Unity TextField 内部文本元素 */
#input-field > .unity-text-element {
    white-space: normal;
    color: #d4d4d4;
    padding: 2px 0;
}

/* Unity TextField multiline 内部 TextInput 容器 */
#input-field > #unity-text-input {
    background-color: #2b2b2b;
    border-width: 0;
    padding: 4px 8px;
    min-height: 20px;
    max-height: 92px;
    white-space: normal;
    overflow: hidden;
}

#input-buttons {
    flex-direction: row;
    flex-shrink: 0;
    align-items: flex-end;
    margin-bottom: 0;
}

#send-button {
    width: 60px;
    height: 28px;
    font-size: 13px;
    -unity-font-style: bold;
    background-color: #4a86c8;
    border-radius: 6px;
    border-width: 0;
    color: #ffffff;
    margin: 0;
    padding: 0;
}

#send-button:hover {
    background-color: #5a96d8;
}

#send-button:active {
    background-color: #3a76b8;
}

#send-button:disabled {
    background-color: #3a5570;
    color: #888888;
}

#cancel-button {
    width: 60px;
    height: 28px;
    font-size: 13px;
    -unity-font-style: bold;
    background-color: #c84a4a;
    border-radius: 6px;
    border-width: 0;
    color: #ffffff;
    margin: 0 0 0 4px;
    padding: 0;
    display: none;
}

#cancel-button:hover {
    background-color: #d85a5a;
}

#cancel-button:active {
    background-color: #b83a3a;
}

/* --- 内嵌工具确认面板 --- */
.tool-confirmation-panel {
    flex-shrink: 0;
    flex-grow: 0;
    margin: 6px 8px 0 8px;
    padding: 10px 12px;
    background-color: #332b1f;
    border-width: 1px;
    border-color: #7a5a2b;
    border-radius: 7px;
}

.tool-confirmation-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.tool-confirmation-title {
    flex-grow: 1;
    font-size: 13px;
    -unity-font-style: bold;
    color: #f0d090;
}

.tool-confirmation-risk {
    font-size: 11px;
    color: #c8a86c;
    margin-left: 8px;
}

.tool-confirmation-description {
    font-size: 12px;
    color: #e0d0b8;
    white-space: normal;
    margin-bottom: 7px;
}

.tool-confirmation-block {
    margin-top: 4px;
    margin-bottom: 2px;
}

.tool-confirmation-section-title {
    font-size: 10px;
    -unity-font-style: bold;
    color: #b89058;
    margin-bottom: 2px;
    letter-spacing: 0.4px;
}

.tool-confirmation-item {
    font-size: 11px;
    color: #d0c0a8;
    white-space: normal;
    margin-left: 4px;
    margin-top: 1px;
}

.tool-confirmation-footer {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}

.tool-confirmation-meta {
    flex-grow: 1;
    font-size: 11px;
    color: #a89070;
}

.tool-confirmation-buttons {
    flex-direction: row;
    flex-shrink: 0;
}

.tool-confirmation-button {
    height: 24px;
    min-width: 72px;
    margin-left: 6px;
    padding: 0 10px;
    border-radius: 5px;
    border-width: 0;
    font-size: 12px;
    -unity-font-style: bold;
    color: #ffffff;
}

.tool-confirmation-button--reject {
    background-color: #7a3a3a;
}

.tool-confirmation-button--reject:hover {
    background-color: #8a4848;
}

.tool-confirmation-button--approve {
    background-color: #4f7f45;
}

.tool-confirmation-button--approve:hover {
    background-color: #5f9054;
}

/* ============================================================
 * Knowledge 面板样式（Phase Hub-2）
 * ============================================================ */

#knowledge-panel {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    display: none;
    overflow: auto;
}

/* KnowledgeBasePanel 根容器 */
.knowledge-panel-content {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    padding: 16px;
    overflow: auto;
    min-height: 0;
}

/* 面板标题 */
.kb-panel__title {
    font-size: 16px;
    -unity-font-style: bold;
    color: #d4d4d4;
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #3a3a3a;
}

/* 区块容器 */
.kb-panel__section {
    flex-direction: column;
    flex-shrink: 0;
    margin-bottom: 16px;
    padding: 12px;
    background-color: #333333;
    border-radius: 6px;
    border-width: 1px;
    border-color: #3f3f3f;
}

/* 区块标题 */
.kb-panel__section-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: #888888;
    margin-bottom: 8px;
    letter-spacing: 0.5px;
}

/* 状态行 */
.kb-panel__status-row {
    font-size: 12px;
    color: #cccccc;
    margin-bottom: 4px;
}

.kb-panel__status-row--muted {
    color: #888888;
    font-size: 11px;
}

/* 状态颜色修饰 */
.kb-panel__status--enabled {
    color: #5cb85c;
}

.kb-panel__status--disabled {
    color: #d9534f;
}

.kb-panel__status--connected {
    color: #5cb85c;
}

.kb-panel__status--failed {
    color: #d9534f;
}

.kb-panel__status--testing {
    color: #f0ad4e;
}

/* 按钮行 */
.kb-panel__button-row {
    flex-direction: row;
    margin-top: 8px;
    flex-wrap: wrap;
}

/* 通用按钮 */
.kb-panel__button {
    height: 26px;
    font-size: 12px;
    padding: 0 12px;
    margin-right: 6px;
    margin-bottom: 4px;
    border-radius: 4px;
    border-width: 1px;
    border-color: #555555;
    background-color: #444444;
    color: #cccccc;
}

.kb-panel__button:hover {
    background-color: #505050;
    color: #ffffff;
}

.kb-panel__button:active {
    background-color: #3a3a3a;
}

.kb-panel__button:disabled {
    background-color: #333333;
    color: #666666;
    border-color: #444444;
}

/* 主要按钮（蓝色） */
.kb-panel__button--primary {
    background-color: #2d5a8e;
    border-color: #3a6fa8;
    color: #e0e0e0;
    -unity-font-style: bold;
    height: 30px;
    font-size: 13px;
    width: 100%;
    margin-right: 0;
}

.kb-panel__button--primary:hover {
    background-color: #3a6fa8;
    color: #ffffff;
}

.kb-panel__button--primary:active {
    background-color: #234a7a;
}

.kb-panel__button--primary:disabled {
    background-color: #1e3a5a;
    color: #666666;
    border-color: #2a4a6a;
}

/* 次要按钮 */
.kb-panel__button--secondary {
    background-color: transparent;
    border-color: #555555;
    color: #888888;
}

.kb-panel__button--secondary:hover {
    background-color: #3a3a3a;
    color: #cccccc;
}

/* 强调按钮（绿色，Ask Agent） */
.kb-panel__button--accent {
    background-color: #2d6e3e;
    border-color: #3a8a50;
    color: #e0e0e0;
    -unity-font-style: bold;
    height: 30px;
    font-size: 13px;
    width: 100%;
    margin-right: 0;
    margin-top: 8px;
}

.kb-panel__button--accent:hover {
    background-color: #3a8a50;
    color: #ffffff;
}

.kb-panel__button--accent:active {
    background-color: #235530;
}

/* 提示文字 */
.kb-panel__hint {
    font-size: 11px;
    color: #666666;
    margin-top: 6px;
    white-space: normal;
}

/* 结果标签 */
.kb-panel__result-label {
    font-size: 12px;
    color: #cccccc;
    white-space: normal;
    margin-bottom: 4px;
}

.kb-panel__result--success {
    color: #5cb85c;
}

.kb-panel__result--failed {
    color: #d9534f;
}

/* 进度遮罩 */
.kb-panel__progress-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    align-items: center;
    justify-content: center;
    border-radius: 4px;
}

.kb-panel__progress-label {
    font-size: 13px;
    color: #d4d4d4;
    -unity-font-style: bold;
}

/* ============================================================
 * Memory 面板样式
 * ============================================================ */

#memory-panel {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    display: none;
    overflow: auto;
}

.memory-panel-content {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    padding: 16px;
    overflow: auto;
    min-height: 0;
}

.memory-panel__title {
    font-size: 16px;
    -unity-font-style: bold;
    color: #d4d4d4;
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #3a3a3a;
}

.memory-panel__section {
    flex-direction: column;
    flex-shrink: 0;
    margin-bottom: 16px;
    padding: 12px;
    background-color: #333333;
    border-radius: 6px;
    border-width: 1px;
    border-color: #3f3f3f;
}

.memory-panel__section-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: #888888;
    margin-bottom: 8px;
    letter-spacing: 0.5px;
}

.memory-panel__status-row {
    font-size: 12px;
    color: #cccccc;
    margin-bottom: 4px;
}

.memory-panel__status-row--muted {
    color: #888888;
    font-size: 11px;
}

.memory-panel__status--ok {
    color: #5cb85c;
}

.memory-panel__status--warn {
    color: #f0ad4e;
}

.memory-panel__status--error {
    color: #d9534f;
}

.memory-panel__button-row {
    flex-direction: row;
    margin-top: 8px;
    flex-wrap: wrap;
}

.memory-panel__button {
    height: 26px;
    font-size: 12px;
    padding: 0 12px;
    margin-right: 6px;
    margin-bottom: 4px;
    border-radius: 4px;
    border-width: 1px;
    border-color: #555555;
    background-color: #444444;
    color: #cccccc;
}

.memory-panel__button:hover {
    background-color: #505050;
    color: #ffffff;
}

.memory-panel__button:active {
    background-color: #3a3a3a;
}

.memory-panel__button:disabled {
    background-color: #333333;
    color: #666666;
    border-color: #444444;
}

.memory-panel__button--primary {
    background-color: #2d5a8e;
    border-color: #3a6fa8;
    color: #e0e0e0;
    -unity-font-style: bold;
    height: 30px;
    font-size: 13px;
    width: 100%;
    margin-right: 0;
    margin-top: 8px;
}

.memory-panel__button--primary:hover {
    background-color: #3a6fa8;
    color: #ffffff;
}

.memory-panel__button--secondary {
    background-color: transparent;
    border-color: #555555;
    color: #888888;
}

.memory-panel__button--secondary:hover {
    background-color: #3a3a3a;
    color: #cccccc;
}

.memory-panel__button--small {
    height: 20px;
    font-size: 11px;
    padding: 0 8px;
    margin-right: 0;
    margin-bottom: 0;
}

.memory-panel__button--danger {
    background-color: #5a2020;
    border-color: #7a3030;
    color: #e08080;
}

.memory-panel__button--danger:hover {
    background-color: #7a2a2a;
    color: #ffaaaa;
    border-color: #aa4040;
}

.memory-panel__hint {
    font-size: 11px;
    color: #666666;
    margin-top: 6px;
    white-space: normal;
}

.memory-panel__result-label {
    font-size: 12px;
    color: #cccccc;
    white-space: normal;
    margin-top: 6px;
    margin-bottom: 4px;
}

.memory-panel__result--success {
    color: #5cb85c;
}

.memory-panel__result--failed {
    color: #d9534f;
}

.memory-panel__text-field {
    min-height: 74px;
    max-height: 120px;
    background-color: #2b2b2b;
    border-radius: 4px;
    border-width: 1px;
    border-color: #555555;
    color: #d4d4d4;
    white-space: normal;
}

.memory-panel__text-field > #unity-text-input {
    background-color: #2b2b2b;
    border-width: 0;
    color: #d4d4d4;
    white-space: normal;
}

.memory-panel__list-title-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.memory-panel__memories-scroll {
    background-color: #2a2a2a;
    border-radius: 4px;
    border-width: 1px;
    border-color: #3a3a3a;
    margin-top: 4px;
    margin-bottom: 4px;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 120px;
}

.memory-panel__memory-item {
    flex-direction: column;
    padding: 8px 10px;
    border-bottom-width: 1px;
    border-bottom-color: #3a3a3a;
    background-color: transparent;
}

.memory-panel__memory-item:hover {
    background-color: #333333;
}

.memory-panel__memory-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.memory-panel__memory-title {
    font-size: 12px;
    color: #d4d4d4;
    -unity-font-style: bold;
    flex-grow: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.memory-panel__memory-content {
    font-size: 12px;
    color: #cccccc;
    white-space: normal;
    margin-bottom: 4px;
}

.memory-panel__memory-meta {
    font-size: 11px;
    color: #777777;
    white-space: normal;
}

/* ============================================================
 * Domain Reload 恢复通知卡片样式
 * 琥珀色/橙色主题，深色背景，与现有 UI 风格协调
 * ============================================================ */

/* --- 通知卡片容器 --- */
.domain-reload-notification {
    flex-direction: column;
    margin: 8px 12px;
    padding: 10px 14px;
    border-radius: 6px;
    background-color: #2a2520;
    border-width: 1px;
    border-color: #8b6914;
    border-left-width: 3px;
    border-left-color: #d4a017;
}

/* --- 标题行（图标 + 文字） --- */
.domain-reload-notification__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.domain-reload-notification__header-icon {
    font-size: 14px;
    color: #d4a017;
    margin-right: 6px;
    flex-shrink: 0;
}

.domain-reload-notification__header-text {
    font-size: 12px;
    -unity-font-style: bold;
    color: #d4a017;
    flex-grow: 1;
}

/* --- 详情行 --- */
.domain-reload-notification__detail {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
    margin-bottom: 1px;
    margin-left: 20px;
}

.domain-reload-notification__detail-label {
    font-size: 11px;
    color: #999080;
    min-width: 72px;
    flex-shrink: 0;
}

.domain-reload-notification__detail-value {
    font-size: 11px;
    color: #c8b890;
    flex-grow: 1;
}

/* --- 状态行 --- */
.domain-reload-notification__status {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: #3a3530;
}

.domain-reload-notification__status-icon {
    font-size: 12px;
    margin-right: 6px;
    flex-shrink: 0;
    color: #d4a017;
}

.domain-reload-notification__status-text {
    font-size: 11px;
    color: #b8a878;
}

/* --- 成功状态修饰 --- */
.domain-reload-notification--success .domain-reload-notification__status-icon {
    color: #5cb85c;
}

.domain-reload-notification--success .domain-reload-notification__status-text {
    color: #7dce7d;
}

.domain-reload-notification--success {
    border-left-color: #5cb85c;
    border-color: #3a6b3a;
}

/* --- 失败状态修饰 --- */
.domain-reload-notification--error .domain-reload-notification__status-icon {
    color: #d9534f;
}

.domain-reload-notification--error .domain-reload-notification__status-text {
    color: #e8706c;
}

.domain-reload-notification--error {
    border-left-color: #d9534f;
    border-color: #6b3a3a;
}

/* --- 编译成功标记 --- */
.domain-reload-notification__compile-success {
    color: #5cb85c;
}

/* --- 编译失败标记 --- */
.domain-reload-notification__compile-error {
    color: #d9534f;
}

/* ============================================================
 * 工具调用分组容器样式
 * 将所有工具调用统一在一个可折叠的容器中
 * ============================================================ */

/* --- 分组容器根 --- */
.tool-call-group {
    flex-direction: column;
    margin: 4px 8px;
    border-radius: 4px;
    border-width: 1px;
    border-color: #383838;
    border-left-width: 3px;
    border-left-color: #4A90D9;
    overflow: hidden;
}

/* --- 分组头部（可点击） --- */
.tool-call-group__header {
    flex-direction: row;
    align-items: center;
    background-color: #333333;
    padding: 6px 10px;
    min-height: 28px;
}

.tool-call-group__header:hover {
    background-color: #3D3D3D;
}

/* --- 折叠箭头 --- */
.tool-call-group__arrow {
    font-size: 10px;
    color: #888888;
    margin-right: 6px;
    min-width: 14px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

/* --- 标题文本 --- */
.tool-call-group__title {
    font-size: 12px;
    color: #D4D4D4;
    -unity-font-style: bold;
    margin-right: 8px;
    flex-shrink: 0;
}

/* --- 摘要标签 --- */
.tool-call-group__summary {
    font-size: 11px;
    color: #888888;
    flex-grow: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* --- 内容区域 --- */
.tool-call-group__content {
    flex-direction: column;
    background-color: #292929;
    padding: 2px 0;
}

/* ============================================================
 * Knowledge Base 文档列表样式（Phase RAG-Doc-1）
 * ============================================================ */

/* 小尺寸按钮（刷新、删除等行内按钮） */
.kb-panel__button--small {
    height: 20px;
    font-size: 11px;
    padding: 0 8px;
    margin-right: 0;
    margin-bottom: 0;
}

/* 危险按钮（删除，红色） */
.kb-panel__button--danger {
    background-color: #5a2020;
    border-color: #7a3030;
    color: #e08080;
}

.kb-panel__button--danger:hover {
    background-color: #7a2a2a;
    color: #ffaaaa;
    border-color: #aa4040;
}

.kb-panel__button--danger:active {
    background-color: #3a1515;
}

/* 文档列表 ScrollView */
.kb-panel__docs-scroll {
    background-color: #2a2a2a;
    border-radius: 4px;
    border-width: 1px;
    border-color: #3a3a3a;
    margin-top: 4px;
    margin-bottom: 4px;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 100px;
}

/* 文档列表条目 */
.kb-panel__doc-item {
    flex-direction: column;
    padding: 8px 10px;
    border-bottom-width: 1px;
    border-bottom-color: #3a3a3a;
    background-color: transparent;
}

.kb-panel__doc-item:hover {
    background-color: #333333;
}

/* 文档条目：文件名 */
.kb-panel__doc-item__name {
    font-size: 12px;
    color: #d4d4d4;
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* 文档条目：摘要 */
.kb-panel__doc-item__summary {
    font-size: 11px;
    color: #888888;
    margin-top: 3px;
    white-space: normal;
}

/* 文档条目：错误信息 */
.kb-panel__doc-item__error {
    font-size: 11px;
    color: #d9534f;
    margin-top: 3px;
    white-space: normal;
}

/* 文档条目：元信息（块数等） */
.kb-panel__doc-item__meta {
    font-size: 10px;
    color: #666666;
    margin-top: 4px;
}

/* 文档条目：底部行 */
.kb-panel__doc-item__bottom-row {
    margin-top: 4px;
}

/* 文档条目：状态徽章 */
.kb-panel__doc-item__status-badge {
    font-size: 10px;
    -unity-font-style: bold;
    padding: 1px 6px;
    border-radius: 3px;
    border-width: 1px;
    margin-left: 6px;
    flex-shrink: 0;
}

/* 状态徽章 — 已处理（绿色） */
.kb-panel__doc-item__status-badge--processed {
    color: #5cb85c;
    border-color: #3a6b3a;
    background-color: #1a3a1a;
}

/* 状态徽章 — 处理中（黄色） */
.kb-panel__doc-item__status-badge--pending {
    color: #f0ad4e;
    border-color: #7a5a20;
    background-color: #2a2010;
}

/* 状态徽章 — 失败（红色） */
.kb-panel__doc-item__status-badge--failed {
    color: #d9534f;
    border-color: #6b3a3a;
    background-color: #2a1515;
}

/* 状态徽章 — 未知 */
.kb-panel__doc-item__status-badge--unknown {
    color: #888888;
    border-color: #555555;
    background-color: #2a2a2a;
}
