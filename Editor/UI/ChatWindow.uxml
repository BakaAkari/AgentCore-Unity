<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
  <ui:VisualElement name="root-container">
    <!-- 顶部工具栏 -->
    <ui:VisualElement name="toolbar">
      <ui:Label name="title-label" text="AgentCore" />
      <ui:VisualElement name="toolbar-spacer" />
      <ui:Label name="status-label" text="就绪" />
    </ui:VisualElement>

    <!-- 主体区域（Hub Rail + Context Sidebar + Main Content） -->
    <ui:VisualElement name="main-body">
      <!-- Hub Rail 由 C# 动态插入 -->

      <!-- Context Sidebar（Chat 模块时显示会话列表） -->
      <ui:VisualElement name="context-sidebar">
        <!-- 会话侧边栏内容（Chat 模块的上下文） -->
        <ui:VisualElement name="session-sidebar-content">
          <!-- 侧边栏头部 -->
          <ui:VisualElement name="sidebar-header">
            <ui:Label name="sidebar-title" text="会话列表" />
            <ui:Button name="new-session-button" text="+ 新建" tooltip="新建会话" />
          </ui:VisualElement>
          <!-- 会话列表滚动区域 -->
          <ui:ScrollView name="session-list-scroll">
            <ui:VisualElement name="session-list-container" />
          </ui:ScrollView>
        </ui:VisualElement>
      </ui:VisualElement>

      <!-- 主内容区域 -->
      <ui:VisualElement name="main-content">
        <!-- Chat 面板 -->
        <ui:VisualElement name="chat-panel">
          <!-- 聊天内容区域 -->
          <ui:VisualElement name="chat-area">
            <!-- 消息列表区域（可滚动） -->
            <ui:ScrollView name="message-scroll-view">
              <ui:VisualElement name="message-container" />
            </ui:ScrollView>

            <!-- 底部输入区域 -->
            <ui:VisualElement name="input-area">
              <ui:TextField name="input-field" multiline="true" />
              <ui:VisualElement name="input-buttons">
                <ui:Button name="send-button" text="发送" />
                <ui:Button name="cancel-button" text="取消" />
              </ui:VisualElement>
            </ui:VisualElement>
          </ui:VisualElement>
        </ui:VisualElement>

        <!-- Knowledge 面板（占位，Phase Hub-2 实现） -->
        <ui:VisualElement name="knowledge-panel">
          <ui:VisualElement name="knowledge-placeholder">
            <ui:Label name="knowledge-placeholder-title" text="Knowledge Base" />
            <ui:Label name="knowledge-placeholder-desc" text="知识库管理功能即将上线" />
          </ui:VisualElement>
        </ui:VisualElement>

        <!-- Memory 面板（占位，Phase Hub-5 实现） -->
        <ui:VisualElement name="memory-panel">
          <ui:VisualElement name="memory-placeholder">
            <ui:Label name="memory-placeholder-title" text="Memory" />
            <ui:Label name="memory-placeholder-desc" text="记忆管理功能即将上线" />
          </ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
