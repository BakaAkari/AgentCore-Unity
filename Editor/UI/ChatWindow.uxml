<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
  <ui:VisualElement name="root-container">
    <!-- 顶部工具栏 -->
    <ui:VisualElement name="toolbar">
      <ui:Label name="title-label" text="AgentCore" />
      <ui:VisualElement name="toolbar-spacer" />
    </ui:VisualElement>

    <!-- 主体区域（Hub Rail + Context Sidebar + Main Content） -->
    <ui:VisualElement name="main-body">
      <!-- Hub Rail 由 C# 动态插入 -->

      <!-- Context Sidebar（Chat 模块时显示会话列表） -->
      <ui:VisualElement name="context-sidebar">
        <!-- 会话侧边栏内容（Chat 模块的上下文） -->
        <ui:VisualElement name="session-sidebar-content">
          <!-- 侧边栏头部 -->
          <ui:VisualElement name="sidebar-header">
            <ui:VisualElement name="sidebar-title-group" style="flex-direction: row; align-items: center; flex-grow: 1;">
              <ui:Label name="sidebar-title" text="会话列表" />
              <ui:Button name="session-sort-button" tooltip="排序方式" />
            </ui:VisualElement>
            <ui:Button name="new-session-button" text="+ 新建" tooltip="新建会话" />
          </ui:VisualElement>
          <!-- 会话列表滚动区域 -->
          <ui:ScrollView name="session-list-scroll">
            <ui:VisualElement name="session-list-container" />
          </ui:ScrollView>
        </ui:VisualElement>
      </ui:VisualElement>

      <!-- 主内容区域 -->
      <ui:VisualElement name="main-content">
        <!-- Chat 面板 -->
        <ui:VisualElement name="chat-panel">
          <!-- 聊天内容区域 -->
          <ui:VisualElement name="chat-area">
            <!-- 消息列表 + 跳底部浮动按钮 -->
            <ui:VisualElement name="message-scroll-wrapper" style="flex-grow: 1; position: relative;">
              <ui:ScrollView name="message-scroll-view">
                <ui:VisualElement name="message-container" />
              </ui:ScrollView>
              <!-- 浮动"跳到底部"按钮：只在用户上翻时显示 -->
              <ui:Button name="scroll-to-bottom-button" text="跳到最新" style="display: none;" tooltip="回到最新消息" />
            </ui:VisualElement>

            <!-- 底部输入区域 -->
            <ui:VisualElement name="input-area">
              <!-- 输入框滚动包装：内容多时可滚动，光标位置跟随 -->
              <ui:ScrollView name="input-scroll-view">
                <ui:TextField name="input-field" multiline="true" />
              </ui:ScrollView>
              <ui:VisualElement name="input-buttons">
                <!-- 右下角两行：上排 send/cancel；下排 + 与思考强度(auto)左侧对齐，整体居右 -->
                <ui:VisualElement name="input-right-col">
                  <ui:VisualElement name="input-top-row">
                    <ui:Button name="cancel-button" text="■" tooltip="停止当前操作" />
                    <ui:Button name="send-button" text="发送" />
                  </ui:VisualElement>
                  <ui:VisualElement name="input-bottom-row">
                    <ui:Button name="attach-button" text="+" tooltip="上传图片给 Agent 查看（按钮选择文件）" />
                    <!-- 思考强度(auto)下拉由 C# 动态插入到此 slot，位于 + 右侧 -->
                    <ui:VisualElement name="input-ai-selector-slot" />
                  </ui:VisualElement>
                </ui:VisualElement>
              </ui:VisualElement>
            </ui:VisualElement>
          </ui:VisualElement>
        </ui:VisualElement>

        <!-- 动态扩展面板宿主（内置与可选组件由 C# 动态插入） -->
        <ui:VisualElement name="extension-panel-host" />
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
