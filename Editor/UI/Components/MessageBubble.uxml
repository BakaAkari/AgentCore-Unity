<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:VisualElement name="bubble-root" class="message-bubble">
    <ui:VisualElement name="bubble-header">
      <ui:Label name="role-label" />
      <ui:VisualElement name="header-spacer" />
      <ui:Label name="time-label" />
      <ui:Button name="copy-button" class="bubble-copy-button" tooltip="复制气泡完整内容到剪贴板" />
    </ui:VisualElement>
    <ui:VisualElement name="bubble-content">
      <ui:Label name="content-label" />
    </ui:VisualElement>
    <ui:VisualElement name="bubble-footer">
      <ui:VisualElement name="footer-spacer" />
      <ui:Button name="fork-button" class="bubble-fork-button" tooltip="从这条消息开始，复制历史到一个新会话继续" />
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
