/* 模型切换（v1.17.0）：输入区下排最左的胶囊按钮 + 自绘弹出面板。
   沿用 chat 面板深色语言：底色 #2b2b2b / #252526，边框 #3c3c3c，强调色 #4a86c8。 */

/* ── 胶囊按钮 ───────────────────────────────────────────── */

.agentcore-model-selector {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
    min-width: 56px;
    max-width: 180px;
    height: 24px;
    margin: 0 4px 0 0;
    padding: 0 6px 0 8px;
    background-color: #2b2b2b;
    border-width: 1px;
    border-color: #3f3f3f;
    border-radius: 12px;
}

.agentcore-model-selector:hover {
    background-color: #323232;
    border-color: #555555;
}

.agentcore-model-selector:active,
.agentcore-model-selector.is-open {
    background-color: #2a3442;
    border-color: #4a86c8;
}

.agentcore-model-selector__dot {
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    margin-right: 6px;
    border-radius: 3px;
    background-color: #6b6b6b;
}

.agentcore-model-selector__dot.is-ready {
    background-color: #5fb878;
}

.agentcore-model-selector__dot.is-loading {
    background-color: #d8a24a;
}

/* 前缀标签（思考强度胶囊的"思考"） */
.agentcore-model-selector__prefix {
    flex-shrink: 0;
    margin: 0 6px 0 2px;
    padding: 0;
    color: #808080;
    font-size: 11px;
    -unity-text-align: middle-left;
}

.agentcore-model-selector__label {
    flex-grow: 1; /* 箭头始终贴右，两枚胶囊对齐 */
    flex-shrink: 1;
    margin: 0;
    padding: 0;
    color: #d4d4d4;
    font-size: 12px;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.agentcore-model-selector:hover .agentcore-model-selector__label {
    color: #ffffff;
}

.agentcore-model-selector__arrow {
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    margin: 0 0 0 4px;
    -unity-background-image-tint-color: #8a8a8a;
}

.agentcore-model-selector:hover .agentcore-model-selector__arrow,
.agentcore-model-selector.is-open .agentcore-model-selector__arrow {
    -unity-background-image-tint-color: #d4d4d4;
}

/* ── 弹出面板 ───────────────────────────────────────────── */

.agentcore-model-popup {
    background-color: #252526;
    border-width: 1px;
    border-color: #3c3c3c;
    padding: 0 0 4px 0;
}

.agentcore-model-popup__header {
    flex-direction: row;
    align-items: center;
    height: 44px;
    flex-shrink: 0;
    padding: 0 8px 0 12px;
    border-bottom-width: 1px;
    border-color: #333333;
}

.agentcore-model-popup__titles {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.agentcore-model-popup__title {
    margin: 0;
    padding: 0;
    color: #e6e6e6;
    font-size: 12px;
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.agentcore-model-popup__subtitle {
    margin: 1px 0 0 0;
    padding: 0;
    color: #808080;
    font-size: 10px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.agentcore-model-popup__icon-button {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #a0a0a0;
    color: #a0a0a0;
    font-size: 14px;
}

.agentcore-model-popup__icon-button:hover {
    background-color: #353535;
    -unity-background-image-tint-color: #ffffff;
    color: #ffffff;
}

.agentcore-model-popup__icon-button:disabled {
    opacity: 0.35;
}

.agentcore-model-popup__banner {
    height: 26px;
    flex-shrink: 0;
    margin: 4px 8px 0 8px;
    padding: 0 8px;
    border-radius: 4px;
    background-color: #3d3420;
    color: #e0b860;
    font-size: 11px;
    -unity-text-align: middle-left;
}

/* 搜索框 */
.agentcore-model-popup__search {
    flex-direction: row;
    align-items: center;
    height: 26px;
    flex-shrink: 0;
    margin: 8px 8px 0 8px;
    padding: 0 0 0 6px;
    border-width: 1px;
    border-color: #3c3c3c;
    border-radius: 4px;
    background-color: #1e1e1e;
}

.agentcore-model-popup__search:hover {
    border-color: #4a86c8;
}

.agentcore-model-popup__search-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #808080;
}

.agentcore-model-popup__search-field {
    flex-grow: 1;
    margin: 0;
    padding: 0;
}

.agentcore-model-popup__search-field > #unity-text-input {
    margin: 0;
    padding: 0 6px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #e6e6e6;
    font-size: 12px;
}

.agentcore-model-popup__search-placeholder {
    position: absolute;
    left: 26px;
    top: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    color: #6b6b6b;
    font-size: 12px;
    -unity-text-align: middle-left;
}

/* 分区标题 */
.agentcore-model-popup__section {
    height: 22px;
    flex-shrink: 0;
    margin: 4px 0 0 0;
    padding: 0 12px;
    color: #7a7a7a;
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: lower-left;
}

.agentcore-model-popup__list {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 4px;
}

.agentcore-model-popup__list .unity-scroller--vertical {
    width: 8px;
}

.agentcore-model-popup__profiles {
    flex-shrink: 0;
    margin: 0 4px;
}

.agentcore-model-popup__footer {
    flex-shrink: 0;
    margin: 6px 0 0 0;
    padding: 4px 4px 0 4px;
    border-top-width: 1px;
    border-color: #333333;
}

/* 行 */
.agentcore-model-popup__row {
    flex-direction: row;
    align-items: center;
    height: 24px;
    flex-shrink: 0;
    padding: 0 8px 0 4px;
    border-radius: 4px;
    border-left-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}

.agentcore-model-popup__row:hover,
.agentcore-model-popup__row.is-highlighted {
    background-color: #2f3d50;
}

.agentcore-model-popup__row.is-current {
    background-color: #263243;
    border-left-color: #4a86c8;
}

.agentcore-model-popup__row:disabled {
    opacity: 0.5;
}

.agentcore-model-popup__check {
    width: 16px;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    color: #6fa8e8;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.agentcore-model-popup__vendor {
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    color: #707070;
    font-size: 12px;
    -unity-text-align: middle-left;
}

.agentcore-model-popup__row-text {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
    padding: 0;
    color: #d4d4d4;
    font-size: 12px;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.agentcore-model-popup__row.is-current .agentcore-model-popup__row-text {
    color: #ffffff;
    -unity-font-style: bold;
}

.agentcore-model-popup__row-meta {
    flex-shrink: 1;
    max-width: 50%;
    margin: 0 0 0 8px;
    padding: 0;
    color: #7a7a7a;
    font-size: 11px;
    -unity-text-align: middle-right;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.agentcore-model-popup__profile-dot {
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    margin: 0 6px 0 5px;
    border-radius: 3px;
    border-width: 1px;
    border-color: #6b6b6b;
}

.agentcore-model-popup__row.is-current .agentcore-model-popup__profile-dot {
    background-color: #4a86c8;
    border-color: #4a86c8;
}

.agentcore-model-popup__row-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    margin: 0 6px 0 1px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #a0a0a0;
}

.agentcore-model-popup__row-icon.is-glyph > Label {
    margin: 0;
    padding: 0;
    color: #a0a0a0;
    font-size: 12px;
    -unity-text-align: middle-center;
}

.agentcore-model-popup__notice {
    height: 24px;
    margin: 0;
    padding: 0 8px 0 22px;
    color: #808080;
    font-size: 11px;
    -unity-font-style: italic;
    -unity-text-align: middle-left;
}

/* "添加到消息"菜单（AttachmentMenuPopup 复用本面板样式） */
.agentcore-model-popup__row--tall {
    height: 34px;
}

.agentcore-model-popup__hint {
    height: 30px;
    flex-shrink: 0;
    margin: 6px 0 0 0;
    padding: 0 12px;
    border-top-width: 1px;
    border-color: #333333;
    color: #707070;
    font-size: 10px;
    -unity-text-align: middle-left;
}
