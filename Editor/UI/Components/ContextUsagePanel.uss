/* Context Usage Panel Styles */

.context-usage-panel {
    background-color: rgba(0, 0, 0, 0.1);
    border-radius: 4px;
    margin-bottom: 8px;
    padding: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    flex-shrink: 0;
}

/* v1.6.5: 整个 header 都是可点击展开/收起的热区,不再依赖右侧按钮 */
.context-usage-panel__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    cursor: link;
    padding: 2px 4px;
    border-radius: 3px;
}

.context-usage-panel__header:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

.context-usage-panel__header Label {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.9);
}

/* 展开/收起指示符 (纯视觉,不可独立点击) */
.context-usage-panel__toggle-indicator {
    font-size: 11px;
    -unity-font-style: normal;
    color: rgba(255, 255, 255, 0.6);
    min-width: 12px;
    -unity-text-align: middle-right;
}

.context-usage-panel__content {
    flex-direction: column;
}

.context-usage-panel--collapsed .context-usage-panel__content {
    display: none;
}

.context-usage-panel__progress-bar {
    height: 8px;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: 4px;
    margin-bottom: 6px;
    overflow: hidden;
}

.context-usage-panel__progress-fill {
    height: 100%;
    background-color: rgb(51, 204, 77);
    transition-property: width, background-color;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

.context-usage-panel__stats-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 4px;
}

.context-usage-panel__stat-label {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.7);
}

.context-usage-panel__stat-value {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.9);
    -unity-font-style: bold;
    white-space: normal;
    flex-shrink: 1;
    -unity-text-align: middle-right;
}

/* v1.23.0: 周期选择器行与胶囊按钮（使用字面色值以兼容 Unity USS） */
.context-usage-panel__period-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 2px;
    margin-bottom: 5px;
}

.context-usage-panel__period-buttons {
    flex-direction: row;
    align-items: center;
}

.context-usage-panel__period-btn {
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 3px;
    padding-top: 1px;
    padding-bottom: 1px;
    padding-left: 6px;
    padding-right: 6px;
    margin-left: 3px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    height: 18px;
    font-size: 10px;
    color: rgba(255, 255, 255, 0.72);
    cursor: link;
}

.context-usage-panel__period-btn:hover {
    background-color: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.28);
    color: rgba(255, 255, 255, 0.95);
}

.context-usage-panel__period-btn--active {
    background-color: rgba(70, 130, 220, 0.42);
    border-color: rgba(110, 175, 255, 0.8);
    color: #ffffff;
    -unity-font-style: bold;
}

.context-usage-panel__period-btn--active:hover {
    background-color: rgba(85, 145, 235, 0.52);
    border-color: rgba(130, 190, 255, 0.9);
    color: #ffffff;
}

.context-usage-panel__compression-badge {
    background-color: rgba(100, 150, 255, 0.2);
    border-radius: 4px;
    padding: 4px 8px;
    margin-top: 6px;
    align-items: center;
    justify-content: center;
}

.context-usage-panel__compression-badge Label {
    font-size: 11px;
    color: rgb(150, 200, 255);
    -unity-font-style: bold;
}
