/* ============================================================
 * MessageBubble.uss — 消息气泡组件样式
 * 用户消息右对齐蓝色，助手消息左对齐灰色
 * ============================================================ */

/* --- 气泡通用样式 --- */
.message-bubble {
    border-radius: 8px;
    padding: 10px;
    margin: 4px 12px;
    max-width: 82%;
    /* v1.4.0 fix: 强制父容器高度随子元素扩展，防止表格/列表等动态 block 溢出 bubble 灰色背景 */
    flex-shrink: 0;
    flex-grow: 0;
    flex-direction: column;
    height: auto;
}

/* --- 用户消息 --- */
.message-bubble--user {
    background-color: #3a5f8a;
    align-self: flex-end;
}

.message-bubble--user #role-label {
    color: #a0c4e8;
}

.message-bubble--user #content-label {
    color: #ffffff;
}

.message-bubble--user #time-label {
    color: #8ab0d4;
}

/* --- 助手消息 --- */
.message-bubble--assistant {
    background-color: #404040;
    align-self: flex-start;
}

.message-bubble--assistant #role-label {
    color: #88bb88;
}

.message-bubble--assistant #content-label {
    color: #d4d4d4;
}

.message-bubble--assistant #time-label {
    color: #888888;
}

/* --- 错误消息 --- */
.message-bubble--error {
    background-color: #4a1c1c;
    align-self: stretch;
    max-width: 100%;
    border-left-width: 3px;
    border-left-color: #e05555;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-width: 1px;
    border-top-color: #6a3030;
    border-bottom-color: #6a3030;
    border-right-color: #6a3030;
}

.message-bubble--error #role-label {
    color: #ff7777;
    font-size: 11px;
}

.message-bubble--error #content-label {
    color: #e8c0c0;
    font-size: 12px;
    white-space: normal;
    -unity-font-style: normal;
}

.message-bubble--error #time-label {
    color: #c07070;
}

/* --- 错误详情可展开区域 --- */
.error-detail-container {
    margin-top: 6px;
}

.error-detail-separator {
    height: 1px;
    background-color: #6a3030;
    margin-bottom: 4px;
}

.error-detail-header {
    background-color: rgba(0, 0, 0, 0.15);
    border-width: 0;
    border-radius: 3px;
    padding: 3px 6px;
    margin: 0;
    color: #cc9999;
    font-size: 11px;
    -unity-text-align: middle-left;
    cursor: link;
}

.error-detail-header:hover {
    background-color: rgba(0, 0, 0, 0.3);
    color: #ddaaaa;
}

.error-detail-content {
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 3px;
    padding: 6px 8px;
    margin-top: 3px;
    color: #bb9999;
    font-size: 11px;
    white-space: normal;
    -unity-font-style: normal;
    overflow: hidden;
}

/* --- 气泡头部 --- */
#bubble-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

#role-label {
    font-size: 10px;
    -unity-font-style: bold;
}

#header-spacer {
    flex-grow: 1;
}

#time-label {
    font-size: 9px;
}

/* --- 气泡内容 --- */
#bubble-content {
    flex-direction: column;
    /* v1.4.0 fix (Part 3, confirmed via UI Debugger):
       #bubble-content.Layout.height = 360.67px 但 BoundingBox.height = 463.33px
       —— 父容器高度停留在初始 flex 布局值，未跟随 StreamingTextElement 动态添加的
       block 扩展。用 align-items:stretch + flex-shrink:0 + height:auto 强制
       父容器高度 = 子元素总高度。 */
    align-items: stretch;
    flex-shrink: 0;
    flex-grow: 0;
    height: auto;
}

#content-label {
    font-size: 13px;
    white-space: normal;
    -unity-text-align: upper-left;
    /* v1.4.0 fix: 移除 overflow: hidden — 它会阻止 Label 请求高度增长，
       导致长文本被裁剪，用户后续消息气泡叠在 LLM 溢出文本之上。
       flex-shrink: 0 已在 .message-bubble 上生效，父容器不会挤压高度。 */
    flex-shrink: 0;
}

/* --- 流式光标 --- */
.streaming-cursor {
    width: 8px;
    height: 14px;
    background-color: #d4d4d4;
    margin-left: 2px;
    display: none;
}

.streaming-cursor--visible {
    display: flex;
}
