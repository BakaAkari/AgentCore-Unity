# ============================================
# AgentCore Unity Plugin — .gitignore
# ============================================

# --- Unity generated ---
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# --- IDE ---
.vs/
.vscode/
*.csproj
*.sln
*.suo
*.user
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Build artifacts ---
*.apk
*.aab
*.unitypackage
*.app
*.exe
*.dll
!Packages/**/*.dll

# --- Archive ---
# _archive/ contains historical planning documents (completed phases, deprecated
# designs, one-off analysis reports) and reference third-party sources
# (Unity-Skills, unity-mcp-setup). Documents are kept in git for full traceability.
# Binary caches (pypi wheels, tarballs, node_modules) are excluded to keep the
# repo lightweight — clone the upstream tools separately if you need to rebuild them.
_archive/**/pypi-cache/
_archive/**/node_modules/
_archive/**/*.whl
_archive/**/*.tar.gz
_archive/**/*.tgz
_archive/**/*.zip
_archive/**/__pycache__/
_archive/**/*.pyc

# --- Package build output (npm pack / UPM tarball extraction) ---
# .tgz release archives are intentionally tracked (see repo history);
# the extracted 'package/' directory is a build artifact and should not be committed.
package/
package.meta

# --- Host Unity project pollution ---
# When this package is loaded as an in-project Package by an outer Unity project,
# the host project's editor generates meta files for top-level directories
# (Assets/, Packages/, ProjectSettings/, UserSettings/, tools/, Logs/) and
# sub-Packages/ProjectSettings folders inside this package. None of these belong
# to the plugin repo. Tracking history: tools/*.ps1 have no .meta; *.tgz has no .meta.
/Assets.meta
/Logs.meta
/Packages.meta
/Packages/
/ProjectSettings.meta
/ProjectSettings/
/UserSettings.meta
/tools.meta
/tools/*.meta
*.tgz.meta

# --- Python / Docker (if local-ragmem is re-added) ---
__pycache__/
*.pyc
.env
*.egg-info/
dist/
