# ============================================
# AgentCore Unity Plugin — .gitignore
# ============================================

# --- Unity generated ---
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# --- IDE ---
.vs/
.vscode/
*.csproj
*.sln
*.suo
*.user
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Build artifacts ---
*.apk
*.aab
*.unitypackage
*.app
*.exe
*.dll
!Packages/**/*.dll

# --- Archive (reference only, not tracked) ---
_archive/

# --- Package build output (npm pack / UPM tarball extraction) ---
# .tgz release archives are intentionally tracked (see repo history);
# the extracted 'package/' directory is a build artifact and should not be committed.
package/
package.meta

# --- Python / Docker (if local-ragmem is re-added) ---
__pycache__/
*.pyc
.env
*.egg-info/
dist/
